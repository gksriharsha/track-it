<?xml version="1.0" encoding="utf-8"?>
<!-- The tile's ground, for API 24 to 30. The radius is the `r-lg` token from
     src/styles.css, hard-coded because the system's own widget radius is API 31
     — see drawable-v31/widget_background.xml, which is the same shape asking the
     platform instead. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_surface" />
    <corners android:radius="@dimen/widget_corner" />
</shape>
