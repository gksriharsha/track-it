<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Reading a nutrition panel. wry's WebChromeClient turns the WebView's
         VIDEO_CAPTURE request into a runtime request for exactly this permission,
         so without it declared here getUserMedia is denied with no prompt. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Not required: the camera is an accelerator for typing the panel in, never
         the only way to add a food, so a device without one must still install. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- allowBackup was UNSET here, which is not the same as off: it defaults to
         true. Every file under this app's data directory was therefore eligible
         to be uploaded to the user's Google account — and on Android that
         directory is where the app keeps user.db and photos/ full of pack
         photographs. The two rules files below replace "everything" with one
         sealed file that was encrypted with the user's own passphrase before
         anything could pick it up.

         There is a second, quieter fault in the old default. db::resolve copies
         the 39 MB usda_core.db into the same directory, and Auto Backup carries
         25 MB per app — so the backup was over quota by a reference database
         that is already inside the APK, and Android's answer to being over
         quota is to stop backing the app up and tell nobody. The app was very
         likely not being backed up at all.

         Kept as true rather than turned off. Turning it off would fix the leak
         and lose the feature; naming what may travel fixes the leak and keeps
         it. -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.trackit"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The two home-screen widgets.

             `exported="false"`: the only broadcasts either of these answers are
             the system's own widget lifecycle, which is delivered regardless, and
             this app's explicit same-UID refresh. Nothing else has any business
             telling a tile to redraw.

             Neither receiver reads an extra it trusts, and neither opens the log
             database — they read two files of already-formatted strings that Rust
             wrote into `no_backup/`, which is the directory Android documents as
             never automatically backed up.

             No `allowBackup`, `fullBackupContent` or `dataExtractionRules`
             attribute is added here. The snapshot needs none — `no_backup/` is
             excluded by the framework itself — and the wider question of what
             else in this app's data directory is eligible for Google Drive
             belongs to the encryption work, which owns those three attributes. -->
        <receiver
            android:name=".widget.AggregateWidgetProvider"
            android:label="@string/widget_aggregate_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_aggregate_info" />
        </receiver>

        <receiver
            android:name=".widget.QuickAddWidgetProvider"
            android:label="@string/widget_quickadd_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quickadd_info" />
        </receiver>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
