# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# USDA bulk downloads (regenerable, large)
/data/raw/

# Generated by tools/build_reference_db.py — regenerable, 37MB
/src-tauri/resources/usda_core.db

# Rust build output — regenerable, and the single largest thing on disk
# (~21 GB across the desktop and Android profiles at its peak).
/src-tauri/target/
/crates/core/target/

# Gradle build output under the Tauri-generated Android project. The rest of
# gen/android is scaffolding worth keeping; only `build/` is derived, and it
# reached 6.4 GB. Tauri and AGP regenerate both on the next `tauri android build`.
/src-tauri/gen/android/build/
/src-tauri/gen/android/app/build/

# Staged copy of the reference DB. Tauri re-copies it from
# src-tauri/resources/ on every Android build and never cleans it up.
/src-tauri/gen/android/app/src/main/assets/

# pnpm's local content-addressable store (configured in this workspace).
# Regenerable from pnpm-lock.yaml on the next `pnpm install`.
/.pnpm-store/

# Signed APKs produced by `tauri android build`. 35 MB each and rebuilt on
# every release; the source they come from is already tracked.
/artifacts/

# Android upload keystore and the properties file CI writes from secrets.
# A signing key in the repository would let anyone ship an update to the
# installed app.
/src-tauri/gen/android/keystore.properties
*.jks
*.keystore
